# Copy values into your CI / IDE run configuration as --dart-define flags.
# Do not commit real secrets.

APP_MODE=demo
# APP_MODE=production

# Local PC / Chrome:
API_BASE_URL=http://localhost:8000/v1
# Phone on same Wi-Fi (replace with your PC LAN IP):
# API_BASE_URL=http://192.168.1.42:8000/v1
# Android emulator:
# API_BASE_URL=http://10.0.2.2:8000/v1
# Shareable / release APK (HTTPS required):
# API_BASE_URL=https://your-api.example.com/v1

# Optional override — normally the Key ID comes from GET /v1/config + create-order
RAZORPAY_KEY_ID=

# Firebase/FCM optional later — member OTP uses MSG91 via the API (not Firebase Phone Auth)
ENABLE_FIREBASE=false

# Example production run (hosted API):
# flutter run --dart-define=APP_MODE=production --dart-define=API_BASE_URL=https://YOUR-API.onrender.com/v1
#
# Release APK (HTTPS only):
# flutter build apk --release --dart-define=APP_MODE=production --dart-define=API_BASE_URL=https://YOUR-API.onrender.com/v1

# Backend (see backend/.env.example):
# - Laptop: DATABASE_URL=sqlite+aiosqlite:///./multiparking.db
# - Cloud: real Supabase postgresql+asyncpg:// URI (YOUR_PROJECT placeholders stay SQLite)
# - Hosted API: APP_ENV=production, OTP_DEV_MODE=false, MSG91_*, RAZORPAY_*
