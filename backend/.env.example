# Local default — laptop-only SQLite (no Postgres required)
DATABASE_URL=sqlite+aiosqlite:///./multiparking.db

# Cloud: comment out SQLite and set a REAL Supabase URI (never commit the password).
# Dashboard → Project Settings → Database → URI. Special chars in the password must be
# URL-encoded (@ → %40). Direct (5432) or pooler (6543) both work; SSL is forced in code.
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Security — REPLACE these before any shared or production deploy
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30
QR_SECRET=change-me-to-another-long-random-string-32bytes!!

# MSG91 SMS OTP (legacy API path only — Flutter members use Firebase Phone Auth)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=MPARK
MSG91_FLOW_URL=https://control.msg91.com/api/v5/otp

# Unused for Firebase member login. Kept for local /auth/send-otp tests.
OTP_DEV_MODE=true

# Must match the Android Firebase project (token audience).
FIREBASE_PROJECT_ID=multiparking-tower
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

# Razorpay — leave empty for stub/dev-only (NOT production). Fill test keys for phone checkout.
# Key ID is also exposed via GET /v1/config for the Flutter client (never the secret).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks secret, for POST /v1/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# App
APP_NAME=MultiParking Tower API
APP_ENV=development
CORS_ORIGINS=*
GATE_API_KEY=dev-gate-key-change-me

# Pay-as-you-go (paise). Booking fee is non-refundable and credited at exit.
HOURLY_RATE_PAISE=5000
BOOKING_FEE_PAISE=5000

# Gate-staff console accounts (provisioned on startup) — change before shared deploy
STAFF_USERNAME=staff
STAFF_PASSWORD=Parking@123
STAFF_DISPLAY_NAME=Gate Staff
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_DISPLAY_NAME=Tower Admin
