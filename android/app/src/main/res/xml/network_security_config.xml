<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is allowed so a debug/dev APK can reach a LAN FastAPI
  (e.g. http://192.168.x.x:8000). Release / shareable APKs should use HTTPS
  API_BASE_URL; do not rely on cleartext in production.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
